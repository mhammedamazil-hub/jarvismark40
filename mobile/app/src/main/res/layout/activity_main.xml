<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#00090E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:maxWidth="@dimen/column_max_width"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="J.A.R.V.I.S — Mobile Agent"
            android:textColor="#00E5FF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tell it a goal. It sees your screen and drives any app."
            android:textColor="#9FB3B8"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="1. Enable JARVIS Controller (Accessibility)" />

        <TextView
            android:id="@+id/txtAccessibilityState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Status: checking…"
            android:textColor="#FFB300" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Model provider"
            android:textColor="#9FB3B8"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/spinnerProvider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#04141A" />

        <EditText
            android:id="@+id/edtKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="OpenRouter API key (sk-or-…)"
            android:textColor="#E0F7FA"
            android:textColorHint="#5A6E72"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/edtModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="openai/gpt-4o-mini"
            android:hint="Vision model (OpenRouter id)"
            android:textColor="#E0F7FA"
            android:textColorHint="#5A6E72" />

        <Switch
            android:id="@+id/switchConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="🔒 Confirm before sending / posting"
            android:textColor="#E0F7FA"
            android:checked="true" />

        <Switch
            android:id="@+id/switchVoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🔊 JARVIS speaks its replies"
            android:textColor="#E0F7FA"
            android:checked="true" />

        <Button
            android:id="@+id/btnBubble"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Show floating bubble (tap from any app)" />

        <EditText
            android:id="@+id/edtGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minLines="2"
            android:gravity="top"
            android:hint="Goal — e.g. Open WhatsApp, message Ravi 'on my way'"
            android:textColor="#E0F7FA"
            android:textColorHint="#5A6E72" />

        <Button
            android:id="@+id/btnVoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🎙 Speak goal (push to talk)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="⚡ Live assistant"
            android:textColor="#00E5FF"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Ask JARVIS anything — it sees your screen (+ camera) and answers aloud."
            android:textColor="#9FB3B8"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnAsk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="⚡ Ask JARVIS (mic) — instant answer" />

        <Button
            android:id="@+id/btnLook"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="📷 Look at camera — describe what I show" />

        <Switch
            android:id="@+id/switchBackCam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="📷 Use back camera (off = selfie)"
            android:textColor="#E0F7FA" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="2. Start JARVIS (grant screen capture)" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Stop" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Activity log"
            android:textColor="#00E5FF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtLog"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:layout_marginTop="4dp"
            android:padding="8dp"
            android:background="#04141A"
            android:textColor="#9FE8F0"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:scrollbars="vertical" />
    </LinearLayout>
</ScrollView>
